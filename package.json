{
  "name": "@tegroton/wallet-mcp",
  "version": "0.1.0",
  "description": "The TON & GRAM wallet MCP — give any AI assistant read-only on-chain data (balances, tokens, transactions, prices, NFTs, DNS, address validation). One server for Claude, Cursor, Claude Code, ChatGPT and Hermes Agent. No keys, no signing.",
  "type": "module",
  "bin": {
    "tegro-wallet-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "start:http": "node dist/cli.js http",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tegro",
    "tegro-wallet-mcp",
    "tegroton",
    "ton",
    "gram",
    "toncoin",
    "the-open-network",
    "mcp",
    "model-context-protocol",
    "crypto",
    "wallet",
    "blockchain",
    "claude",
    "claude-code",
    "chatgpt",
    "cursor",
    "hermes",
    "tonapi",
    "web3",
    "defi",
    "openapi",
    "ai-tools"
  ],
  "author": {
    "name": "TegroTON"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TegroTON/wallet-mcp.git"
  },
  "homepage": "https://github.com/TegroTON/wallet-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.4.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.1.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  }
}
